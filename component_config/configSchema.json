{
  "type": "object",
  "title": "Azure Table Storage Writer",
  "required": [
    "#connection_string"
  ],
  "properties": {
    "#connection_string": {
      "type": "string",
      "title": "Connection String",
      "description": "Azure Storage account connection string (will be encrypted).",
      "format": "password",
      "propertyOrder": 1
    },
    "test_connection": {
      "type": "button",
      "title": "Test Connection",
      "format": "test-connection",
      "propertyOrder": 2,
      "options": {
        "async": {
          "action": "testConnection",
          "label": "Test Connection"
        }
      }
    },
    "debug": {
      "type": "boolean",
      "title": "Debug Mode",
      "description": "Enable verbose debug logging.",
      "default": false,
      "propertyOrder": 3
    }
  }
}
